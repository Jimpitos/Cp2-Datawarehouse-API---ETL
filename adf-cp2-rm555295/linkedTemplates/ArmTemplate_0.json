									"sink1": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-09-26T04:42:36Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_REST')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Raw')]",
				"[concat(variables('factoryId'), '/dataflows/DF_Carga_Dimensao')]",
				"[concat(variables('factoryId'), '/dataflows/DF_Carga_Fato')]"
			]
		}
